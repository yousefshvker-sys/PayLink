
@startuml

skinparam classAttributeIconSize 0

abstract class User {
    - id: int
    - name: string
    - phoneNumber: string
    - passwordHash: string
    - status: AccountStatus
    + login()
    + logout()
}

class Customer {
    - verificationLevel: string
    + register()
    + viewWallet()
    + viewTransactionHistory()
}

class Agent {
    - commissionRate: decimal
    + topUpCustomerWallet()
    + payBillForCustomer()
}

class Admin {
    + manageBillers()
    + manageServices()
    + manageFeesAndLimits()
    + viewDailyTotals()
}

class SupportEmployee {
    + searchPayment()
    + approveRefund()
    + rejectRefund()
    + blockAccount()
    + unblockAccount()
}

class Wallet {
    - id: int
    - availableBalance: decimal
    - heldBalance: decimal
    - currency: string
}

class LedgerEntry {
    - id: int
    - type: string
    - amount: decimal
    - createdAt: datetime
    - reference: string
}

class Payment {
    - id: int
    - reference: string
    - amount: decimal
    - fee: decimal
    - totalAmount: decimal
    - status: PaymentStatus
    - createdAt: datetime
}

User <|-- Customer
User <|-- Agent
User <|-- Admin
User <|-- SupportEmployee

Customer "1" -- "1" Wallet
Agent "1" -- "0..1" Wallet
Wallet "1" -- "0..*" LedgerEntry
Wallet "1" -- "0..*" Payment
Payment "1" -- "0..*" LedgerEntry


class Biller {
    - id: int
    - name: string
    - protocol: string
    - isActive: boolean
    + enable()
    + disable()
}

class Service {
    - id: int
    - name: string
    - minAmount: decimal
    - maxAmount: decimal
    - isActive: boolean
}

class FeeRule {
    - id: int
    - feeType: string
    - feeValue: decimal
    - minimumFee: decimal
    + calculateFee(amount: decimal): decimal
}

class Refund {
    - id: int
    - amount: decimal
    - reason: string
    - status: RefundStatus
    - createdAt: datetime
    + approve()
    + reject()
}

class PaymentEvent {
    - id: int
    - oldState: string
    - newState: string
    - createdAt: datetime
}

class Commission {
    - id: int
    - amount: decimal
    - createdAt: datetime
}

class AuditLog {
    - id: int
    - action: string
    - details: string
    - createdAt: datetime
}

class NotificationLog {
    - id: int
    - channel: string
    - status: string
    - attempts: int
    - createdAt: datetime
}

class IdempotencyRecord {
    - id: int
    - key: string
    - response: string
    - createdAt: datetime
}

enum PaymentStatus {
    Initiated
    FundsHeld
    SentToBiller
    Unknown
    Completed
    Failed
    Rejected
    Refunded
}

enum AccountStatus {
    Active
    Blocked
    Disabled
}

enum RefundStatus {
    Pending
    Approved
    Rejected
}

Biller "1" -- "1..*" Service
Service "1" -- "0..*" Payment
Biller "1" -- "0..*" Payment
FeeRule "1" -- "0..*" Service

Payment "1" -- "0..*" PaymentEvent
Payment "1" -- "0..*" Refund
Payment "1" -- "0..*" NotificationLog
Payment "1" -- "0..1" IdempotencyRecord

Agent "1" -- "0..*" Commission
Payment "1" -- "0..1" Commission

User "1" -- "0..*" AuditLog

@enduml

