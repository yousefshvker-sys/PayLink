
@startuml

skinparam classAttributeIconSize 0

abstract class User {
    - id: int
    - name: string
    - phoneNumber: string
    - passwordHash: string
    - status: AccountStatus
    + login()
    + logout()
}

class Customer {
    - verificationLevel: string
    + register()
    + viewWallet()
    + viewTransactionHistory()
}

class Agent {
    - commissionRate: decimal
    + topUpCustomerWallet()
    + payBillForCustomer()
}

class Admin {
    + manageBillers()
    + manageServices()
    + manageFeesAndLimits()
    + viewDailyTotals()
}

class SupportEmployee {
    + searchPayment()
    + approveRefund()
    + rejectRefund()
    + blockAccount()
    + unblockAccount()
}

class Wallet {
    - id: int
    - availableBalance: decimal
    - heldBalance: decimal
    - currency: string
}

class LedgerEntry {
    - id: int
    - type: string
    - amount: decimal
    - createdAt: datetime
    - reference: string
}

class Payment {
    - id: int
    - reference: string
    - amount: decimal
    - fee: decimal
    - totalAmount: decimal
    - status: PaymentStatus
    - createdAt: datetime
}

User <|-- Customer
User <|-- Agent
User <|-- Admin
User <|-- SupportEmployee

Customer "1" -- "1" Wallet
Agent "1" -- "0..1" Wallet
Wallet "1" -- "0..*" LedgerEntry
Wallet "1" -- "0..*" Payment
Payment "1" -- "0..*" LedgerEntry

@enduml

