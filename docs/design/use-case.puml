
@startuml
left to right direction

actor Customer
actor Agent
actor Admin
actor "Support Employee" as Support
actor "Biller Company" as Biller
actor "Notification Provider" as Notification

rectangle PayLink {

    usecase "Register Account" as UC1
    usecase "View Wallet Balance" as UC2
    usecase "View Transaction History" as UC3
    usecase "Top Up Wallet" as UC4

    usecase "View Billers and Services" as UC5
    usecase "Inquire About Bill" as UC6
    usecase "Pay a Bill" as UC7
    usecase "View Payment Status" as UC8
    usecase "Request Refund" as UC9

    usecase "Pay Bill for Customer" as UC10
    usecase "Earn Commission" as UC11

    usecase "Manage Billers and Services" as UC12
    usecase "Manage Fees and Limits" as UC13
    usecase "View Daily Totals" as UC14

    usecase "Search Payments" as UC15
    usecase "View Payment History and Events" as UC16
    usecase "Approve or Reject Refund" as UC17
    usecase "Block or Unblock Account" as UC18

    usecase "Process Bill Payment" as UC19
    usecase "Send Payment Notification" as UC20
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC5
Customer --> UC6
Customer --> UC7
Customer --> UC8
Customer --> UC9

Agent --> UC10
Agent --> UC4
Agent --> UC11

Admin --> UC12
Admin --> UC13
Admin --> UC14

Support --> UC15
Support --> UC16
Support --> UC17
Support --> UC18

Biller --> UC19
Notification --> UC20

UC7 ..> UC19 : <<include>>
UC10 ..> UC19 : <<include>>

@enduml

